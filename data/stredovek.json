{
  "title": "Středověk",
  "version": 2,
  "sync": "line",
  "lines": [
    {
      "start": 3,
      "end": 9,
      "text": "Středověk – páté až patnácté století."
    },
    {
      "start": 9,
      "end": 13,
      "text": "Od pádu Říma k novému věku letí."
    },
    {
      "start": 13,
      "end": 18,
      "text": "Víra, církev, rytíři, hrady."
    },
    {
      "start": 18,
      "end": 24,
      "text": "Literatura učí víře a zásadám."
    },
    {
      "start": 24,
      "end": 40,
      "text": "Legenda – světec, víra, zázraky! Epos – hrdina, rytíř, čest a odvaha! Kronika – dějiny, rok za rokem! Kosmas a Dalimil – to musíš znát!"
    },
    {
      "start": 40,
      "end": 46,
      "text": "Legenda vypráví o životě světce, o víře, skutcích, utrpení a smrti."
    },
    {
      "start": 46,
      "end": 50,
      "text": "Má náboženský a výchovný význam."
    },
    {
      "start": 50,
      "end": 51,
      "text": "Legenda o svatém Prokopu."
    },
    {
      "start": 51,
      "end": 53,
      "text": "Legenda o svaté Kateřině."
    },
    {
      "start": 53,
      "end": 55,
      "text": "Rytířský a hrdinský epos."
    },
    {
      "start": 55,
      "end": 59,
      "text": "Píseň o Rolandovi – Francie."
    },
    {
      "start": 59,
      "end": 61,
      "text": "Píseň o Nibelunzích – Německo."
    },
    {
      "start": 61,
      "end": 65,
      "text": "Slovo o pluku Igorově – Rusko."
    },
    {
      "start": 65,
      "end": 72,
      "text": "Kronika zapisuje dějiny, události v časové posloupnosti."
    },
    {
      "start": 72,
      "end": 73,
      "text": "KOSMAS!"
    },
    {
      "start": 73,
      "end": 75,
      "text": "Dvanácté století!"
    },
    {
      "start": 75,
      "end": 76,
      "text": "Kronika česká!"
    },
    {
      "start": 76,
      "end": 78,
      "text": "Latinsky, prózou!"
    },
    {
      "start": 78,
      "end": 85,
      "text": "Kosmas, pražský děkan, od bájných počátků po svou dobu."
    },
    {
      "start": 85,
      "end": 88,
      "text": "Kronika čtrnácté století!"
    },
    {
      "start": 88,
      "end": 94,
      "text": "Česky a ve verších!"
    },
    {
      "start": 94,
      "end": 96,
      "text": "Kosmas – latina, próza! Dalimil – čeština, verš!"
    },
    {
      "start": 96,
      "end": 107,
      "text": "Legenda – světec! Epos – hrdina! Kronika – dějiny! Kosmas – latina, próza! Dalimil – čeština, verš!"
    },
    {
      "start": 107,
      "end": 111,
      "text": "Mastičkář – nejstarší česká světská hra!"
    },
    {
      "start": 111,
      "end": 116,
      "text": "Hradecký rukopis, Podkoní a žák – satirický spor."
    },
    {
      "start": 116,
      "end": 121,
      "text": "Jistebnický kancionál – husitské písně! Mastičkář!"
    },
    {
      "start": 121,
      "end": 124,
      "text": "Hradecký rukopis! Podkoní a žák!"
    },
    {
      "start": 124,
      "end": 130,
      "text": "Jistebnický kancionál! Husovi předchůdci: Konrád Waldhauser, Jan Milíč z Kroměříže."
    },
    {
      "start": 130,
      "end": 135,
      "text": "Matěj z Janova, Tomáš Štítný ze Štítného."
    },
    {
      "start": 135,
      "end": 153,
      "text": "Kritizují mravní úpadek církve a volají po návratu ke křesťanství. Štítný píše česky, zdůrazňuje morálku."
    },
    {
      "start": 153,
      "end": 156,
      "text": "Mistr Jan Hus – kolem roku 1370, z Husince, působí v Praze."
    },
    {
      "start": 156,
      "end": 158,
      "text": "Kazatel z Betlémské kaple."
    },
    {
      "start": 158,
      "end": 179,
      "text": "Kritizuje úpadek církve, prodej odpustků a zneužívání moci. Chce pravdu, Bibli a reformu církve."
    },
    {
      "start": 179,
      "end": 184,
      "text": "O církvi – De ecclesia. Výklad víry, Desatera a Páteře."
    },
    {
      "start": 184,
      "end": 190,
      "text": "Kostnice, 1415, Jan Hus je upálen."
    },
    {
      "start": 190,
      "end": 199,
      "text": "HUS – PRAVDA, BIBLE, REFORMA!"
    },
    {
      "start": 199,
      "end": 206,
      "text": "Petr Chelčický: víra bez násilí, odmítá válku a moc."
    },
    {
      "start": 206,
      "end": 211,
      "text": "Život podle Bible a Krista, láska k bližnímu."
    },
    {
      "start": 211,
      "end": 217,
      "text": "Skromnost. Síť víry pravé, kritika církve i světské moci."
    },
    {
      "start": 217,
      "end": 221,
      "text": "Jeho myšlenky ovlivní Jednotu bratrskou."
    },
    {
      "start": 221,
      "end": 225,
      "text": "Středověk – páté až patnácté století."
    },
    {
      "start": 225,
      "end": 228,
      "text": "Legenda – světec! Epos – hrdina! Kronika – dějiny! Kosmas – latina, próza! Dalimil – čeština, verš! Štítný – morálka a vzdělání!"
    },
    {
      "start": 228,
      "end": 231,
      "text": "Hus – pravda, Bible, reforma! Chelčický – nenásilí!"
    },
    {
      "start": 231,
      "end": 235,
      "text": "Mastičkář, Hradecký rukopis, Podkoní a žák, Jistebnický kancionál!"
    },
    {
      "start": 235,
      "end": 239,
      "text": "Středověk, teď už to znáš."
    }
  ]
}
