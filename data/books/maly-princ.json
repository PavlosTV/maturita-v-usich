{
  "title": "Malý princ",
  "version": 1,
  "sync": "line",
  "audio": "./audio/maly-princ.mp3",
  "lines": [
    {"start": 3.24, "end": 4.74, "text": "Malý princ, Malý princ,"},
    {"start": 4.74, "end": 6.72, "text": "příběh, který učí žít."},
    {"start": 6.72, "end": 9.24, "text": "Pod povrchem dětské pohádky"},
    {"start": 9.24, "end": 12.02, "text": "skrývá se, jak světu porozumět."},
    {"start": 12.02, "end": 14.12, "text": "Saint-Exupéry,"},
    {"start": 14.12, "end": 16.10, "text": "rok čtyřicet tři."},
    {"start": 16.10, "end": 18.32, "text": "Filozofická pohádka,"},
    {"start": 18.32, "end": 20.98, "text": "co v srdci stále zní."},
    {"start": 20.98, "end": 23.36, "text": "Malý princ, růže, liška,"},
    {"start": 23.36, "end": 25.76, "text": "každý vztah má vlastní význam."},
    {"start": 25.76, "end": 28.08, "text": "Očima se pravda nevidí,"},
    {"start": 28.08, "end": 30.50, "text": "srdce ví, co oči nevidí."},
    {"start": 30.50, "end": 32.86, "text": "Obsah, kompozice, jazyk,"},
    {"start": 32.86, "end": 35.22, "text": "tři roviny, to je základ."},
    {"start": 35.22, "end": 37.32, "text": "Druh a žánr, postavy,"},
    {"start": 37.32, "end": 40.61, "text": "motivy a jazykové prostředky!"},
    {"start": 40.61, "end": 42.35, "text": "Literární druh? Epika!"},
    {"start": 42.35, "end": 44.73, "text": "Próza, příběh, vyprávění."},
    {"start": 44.73, "end": 47.43, "text": "Žánr? Filozofická pohádka,"},
    {"start": 47.43, "end": 49.45, "text": "novela s alegorií."},
    {"start": 49.45, "end": 51.85, "text": "Hlavní téma? Láska, vztahy,"},
    {"start": 51.85, "end": 54.23, "text": "přátelství a odpovědnost."},
    {"start": 54.23, "end": 56.63, "text": "Dětství, samota, dospělost,"},
    {"start": 56.63, "end": 59.01, "text": "lidská hloupost, pomíjivost."},
    {"start": 59.01, "end": 61.39, "text": "Pilot havaruje v poušti,"},
    {"start": 61.39, "end": 63.75, "text": "tam se s princem setkává."},
    {"start": 63.75, "end": 66.11, "text": "Princ svou planetu opouští,"},
    {"start": 66.11, "end": 68.51, "text": "na svou růži vzpomínává."},
    {"start": 68.51, "end": 70.29, "text": "Putuje z planety na planetu,"},
    {"start": 70.29, "end": 71.47, "text": "poznává svět dospělých."},
    {"start": 71.47, "end": 72.67, "text": "Král, domýšlivec, pijan,"},
    {"start": 72.67, "end": 73.83, "text": "byznysmen a lampář s nimi."},
    {"start": 73.83, "end": 75.65, "text": "Země, liška, její rada,"},
    {"start": 75.65, "end": 77.93, "text": "o vztazích se princ dozvídá."},
    {"start": 77.93, "end": 80.39, "text": "Zkrotit znamená pouto tvořit,"},
    {"start": 80.39, "end": 82.77, "text": "za svou růži odpovědnost mít."},
    {"start": 82.77, "end": 85.13, "text": "Malý princ, růže, liška,"},
    {"start": 85.13, "end": 87.53, "text": "každý vztah má vlastní význam."},
    {"start": 87.53, "end": 89.85, "text": "Očima se pravda nevidí,"},
    {"start": 89.85, "end": 92.27, "text": "srdce ví, co oči nevidí."},
    {"start": 92.27, "end": 94.63, "text": "Obsah, kompozice, jazyk,"},
    {"start": 94.63, "end": 97.01, "text": "tři roviny, to je základ."},
    {"start": 97.01, "end": 99.11, "text": "Druh a žánr, postavy,"},
    {"start": 99.11, "end": 101.75, "text": "motivy a jazykové prostředky!"},
    {"start": 101.75, "end": 103.41, "text": "Prostor? Sahara, poušť,"},
    {"start": 103.41, "end": 104.75, "text": "princova malá planetka."},
    {"start": 104.75, "end": 106.51, "text": "Asteroidu B šest set dvanáct"},
    {"start": 106.51, "end": 109.05, "text": "říká se jeho domovská."},
    {"start": 109.05, "end": 110.09, "text": "Pak další planety,"},
    {"start": 110.09, "end": 111.27, "text": "nakonec i Země."},
    {"start": 111.27, "end": 112.29, "text": "Poušť je místem setkání,"},
    {"start": 112.29, "end": 113.51, "text": "kde pilot pozná změny."},
    {"start": 113.51, "end": 114.79, "text": "Čas není přesně určen,"},
    {"start": 114.79, "end": 116.05, "text": "příběh plyne zpětně."},
    {"start": 116.05, "end": 117.22, "text": "Pilot na vše vzpomíná,"},
    {"start": 117.22, "end": 118.40, "text": "vypráví to osobně."},
    {"start": 118.40, "end": 119.92, "text": "Princ se vrací ke své růži,"},
    {"start": 119.92, "end": 121.38, "text": "konec zůstává tajemný."},
    {"start": 121.38, "end": 122.56, "text": "Odchod, smrt, nebo návrat?"},
    {"start": 122.56, "end": 123.78, "text": "Význam není jednoznačný."},
    {"start": 123.78, "end": 124.96, "text": "Kompozice je převážně"},
    {"start": 124.96, "end": 125.88, "text": "chronologická."},
    {"start": 125.88, "end": 127.04, "text": "Příběh tvoří epizody,"},
    {"start": 127.04, "end": 128.36, "text": "cesta je symbolická."},
    {"start": 128.36, "end": 129.42, "text": "Rámcové vyprávění,"},
    {"start": 129.42, "end": 130.52, "text": "pilot příběh vypráví."},
    {"start": 130.52, "end": 131.74, "text": "V první osobě vzpomíná,"},
    {"start": 131.74, "end": 133.26, "text": "své zážitky nám předává."},
    {"start": 133.26, "end": 134.16, "text": "Pásmo vypravěče,"},
    {"start": 134.16, "end": 135.10, "text": "pásmo postav."},
    {"start": 135.10, "end": 136.26, "text": "Přímá řeč a dialogy,"},
    {"start": 136.26, "end": 137.42, "text": "otázky i odpovědi."},
    {"start": 137.42, "end": 138.90, "text": "Vypravěč? Pilot, účastník,"},
    {"start": 138.90, "end": 140.10, "text": "subjektivní pohled má."},
    {"start": 140.10, "end": 141.28, "text": "Dospělý se učí znovu"},
    {"start": 141.28, "end": 144.54, "text": "vidět svět, jak dítě zná."},
    {"start": 144.54, "end": 146.92, "text": "Malý princ, růže, liška,"},
    {"start": 146.92, "end": 149.32, "text": "každý vztah má vlastní význam."},
    {"start": 149.32, "end": 151.64, "text": "Očima se pravda nevidí,"},
    {"start": 151.64, "end": 153.76, "text": "srdce ví, co oči nevidí."},
    {"start": 153.76, "end": 156.38, "text": "Kompozice a vypravěč,"},
    {"start": 156.38, "end": 158.80, "text": "přímá řeč a dialog."},
    {"start": 158.80, "end": 161.16, "text": "Postavy a jejich vývoj,"},
    {"start": 161.16, "end": 163.54, "text": "tohle všechno patří sem!"},
    {"start": 163.54, "end": 165.26, "text": "Malý princ, čistý pohled,"},
    {"start": 165.26, "end": 166.26, "text": "zvídavost a cit."},
    {"start": 166.26, "end": 167.28, "text": "Učí se, co znamená"},
    {"start": 167.28, "end": 168.48, "text": "někoho opravdu mít rád."},
    {"start": 168.48, "end": 169.80, "text": "Růže je pyšná, zranitelná,"},
    {"start": 169.80, "end": 170.98, "text": "princ ji neumí pochopit."},
    {"start": 170.98, "end": 172.18, "text": "Teprve až svět poznává,"},
    {"start": 172.18, "end": 173.36, "text": "začíná jí rozumět."},
    {"start": 173.36, "end": 174.56, "text": "Liška učí přátelství,"},
    {"start": 174.56, "end": 175.60, "text": "důvěře a blízkosti."},
    {"start": 175.60, "end": 176.86, "text": "Vztah je práce, čas a péče,"},
    {"start": 176.86, "end": 177.84, "text": "vzniká zodpovědnost."},
    {"start": 177.84, "end": 179.30, "text": "Pilot ztrácí dětské vidění,"},
    {"start": 179.30, "end": 180.50, "text": "pak ho znovu objevuje."},
    {"start": 180.50, "end": 181.68, "text": "Díky princi pochopí,"},
    {"start": 181.68, "end": 182.86, "text": "co je důležité."},
    {"start": 182.86, "end": 184.04, "text": "Dospělí jsou často směšní,"},
    {"start": 184.04, "end": 185.12, "text": "čísla, moc a majetek."},
    {"start": 185.12, "end": 186.48, "text": "Zapomínají na to hlavní,"},
    {"start": 186.48, "end": 187.62, "text": "uniká jim lidský svět."},
    {"start": 187.62, "end": 188.86, "text": "Není růže jako růže,"},
    {"start": 188.86, "end": 189.98, "text": "ale jedna je ta tvá."},
    {"start": 189.98, "end": 191.14, "text": "Čas, který jí věnuješ,"},
    {"start": 191.14, "end": 192.26, "text": "zvláštní hodnotu jí dá."},
    {"start": 192.26, "end": 193.93, "text": "Vztah znamená závazek,"},
    {"start": 193.93, "end": 194.97, "text": "nejde jenom o slova."},
    {"start": 194.97, "end": 197.17, "text": "To nejdůležitější se očím neschová."},
    {"start": 199.03, "end": 199.89, "text": "Jazyk jednoduchý,"},
    {"start": 199.89, "end": 201.43, "text": "srozumitelný, poetický."},
    {"start": 201.43, "end": 202.63, "text": "Krátké věty, dialogy,"},
    {"start": 202.63, "end": 204.03, "text": "význam ale filozofický."},
    {"start": 204.03, "end": 205.01, "text": "Spisovná čeština,"},
    {"start": 205.01, "end": 206.11, "text": "převážně neutrální."},
    {"start": 206.11, "end": 207.41, "text": "Citově zabarvená slova,"},
    {"start": 207.41, "end": 208.85, "text": "něžná a obrazná sdělení."},
    {"start": 208.85, "end": 209.83, "text": "Metafora, symbol,"},
    {"start": 209.83, "end": 210.73, "text": "personifikace."},
    {"start": 210.73, "end": 211.69, "text": "Přirovnání, kontrast,"},
    {"start": 211.69, "end": 212.87, "text": "opakování, gradace."},
    {"start": 212.87, "end": 214.17, "text": "Alegorie celého díla,"},
    {"start": 214.17, "end": 215.51, "text": "planety ukazují svět."},
    {"start": 215.51, "end": 216.73, "text": "Postavy jsou obraz lidí,"},
    {"start": 216.73, "end": 217.93, "text": "jejich chyby, jejich střet."},
    {"start": 217.93, "end": 219.71, "text": "Růže symbolizuje lásku,"},
    {"start": 219.71, "end": 221.81, "text": "liška vztah a přátelství."},
    {"start": 221.81, "end": 224.15, "text": "Poušť může znamenat samotu,"},
    {"start": 224.15, "end": 226.93, "text": "studna naději a poznání."},
    {"start": 226.93, "end": 229.29, "text": "Metafora přenáší význam,"},
    {"start": 229.29, "end": 231.43, "text": "symbol zastupuje víc."},
    {"start": 231.43, "end": 234.13, "text": "Personifikace dává věcem"},
    {"start": 234.13, "end": 236.55, "text": "lidskou tvář i lidský cit."},
    {"start": 236.55, "end": 238.95, "text": "Kontrast dětí a dospělých,"},
    {"start": 238.95, "end": 241.09, "text": "povrchnosti proti citu."},
    {"start": 241.09, "end": 243.73, "text": "Opakování důležitých slov"},
    {"start": 243.73, "end": 245.87, "text": "dává důraz příběhu."},
    {"start": 245.87, "end": 247.31, "text": "Alegorie, obraz světa,"},
    {"start": 247.31, "end": 248.53, "text": "skrytý význam postav má."},
    {"start": 248.53, "end": 249.83, "text": "Paradox a moudré výroky,"},
    {"start": 249.83, "end": 251.51, "text": "čtenář nad nimi přemýšlí dál."},
    {"start": 251.51, "end": 252.73, "text": "Veršová výstavba?"},
    {"start": 252.73, "end": 253.91, "text": "Tady verše nenajdeš."},
    {"start": 253.91, "end": 255.13, "text": "Je to próza, ne báseň,"},
    {"start": 255.13, "end": 258.13, "text": "na to nezapomeneš."},
    {"start": 258.13, "end": 260.53, "text": "Malý princ, Saint-Exupéry,"},
    {"start": 260.53, "end": 262.37, "text": "rok čtyřicet tři."},
    {"start": 262.37, "end": 265.39, "text": "Epika, próza, filozofická pohádka,"},
    {"start": 265.39, "end": 267.77, "text": "alegorie, co v srdci zní."},
    {"start": 267.77, "end": 269.55, "text": "Obsah: láska, vztahy,"},
    {"start": 269.55, "end": 271.96, "text": "přátelství, odpovědnost."},
    {"start": 271.96, "end": 273.72, "text": "Prostor: poušť, planety,"},
    {"start": 273.72, "end": 277.04, "text": "čas neurčitý, vzpomínkovost."},
    {"start": 277.04, "end": 278.86, "text": "Kompozice: cesta, epizody,"},
    {"start": 278.86, "end": 280.34, "text": "rámcový příběh, vypravěč."},
    {"start": 280.34, "end": 281.86, "text": "Pilot, přímá řeč, dialogy,"},
    {"start": 281.86, "end": 283.34, "text": "postavy a jejich vývoj."},
    {"start": 283.34, "end": 284.58, "text": "Jazyk: metafora, symbol,"},
    {"start": 284.58, "end": 286.08, "text": "kontrast, personifikace."},
    {"start": 286.08, "end": 287.28, "text": "Alegorie, přirovnání,"},
    {"start": 287.28, "end": 289.34, "text": "opakování, obrazné vyjádření."},
    {"start": 289.34, "end": 291.74, "text": "Malý princ, růže, liška,"},
    {"start": 291.74, "end": 293.10, "text": "každý vztah má vlastní význam."},
    {"start": 293.10, "end": 296.52, "text": "To nejdůležitější není vidět,"},
    {"start": 296.52, "end": 298.98, "text": "srdcem musíš poznat pravdu sám."},
    {"start": 298.98, "end": 301.38, "text": "Obsah, kompozice, jazyk,"},
    {"start": 301.38, "end": 303.58, "text": "tři roviny, to je základ."},
    {"start": 303.58, "end": 305.74, "text": "Malý princ nás učí žít,"},
    {"start": 305.74, "end": 308.00, "text": "milovat a odpovědnost mít."}
  ]
}
