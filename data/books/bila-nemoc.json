
{
  "title": "Bílá nemoc",
  "version": 1,
  "sync": "line",
  "audio": "./audio/bila-nemoc.mp3",
  "lines": [
    {"start": 2.70, "end": 7.26, "text": "Rok třicet sedm, svět plný napětí,"},
    {"start": 7.26, "end": 11.16, "text": "nemoc se šíří, strach obchází lidi."},
    {"start": 11.16, "end": 13.58, "text": "A zatímco mocní chtějí válku,"},
    {"start": 13.58, "end": 21.04, "text": "jeden lékař hledá cestu k míru."},
    {"start": 21.04, "end": 24.66, "text": "Doktor Galén zná lék na nemoc,"},
    {"start": 24.66, "end": 29.20, "text": "která starší lidi připravuje o život."},
    {"start": 29.20, "end": 32.12, "text": "Chce ho však dát jen tomu,"},
    {"start": 32.12, "end": 39.32, "text": "kdo odmítne válku a zvolí mír."},
    {"start": 39.32, "end": 42.96, "text": "Maršál chce dobýt další země,"},
    {"start": 42.96, "end": 47.32, "text": "Krüg vyrábí zbraně pro jeho plány."},
    {"start": 47.32, "end": 51.04, "text": "Galén se jim staví, nechce být nástrojem,"},
    {"start": 51.04, "end": 57.02, "text": "léčit chce lidi, ne podporovat zabíjení."},
    {"start": 57.02, "end": 59.00, "text": "Bílá nemoc, strach a moc,"},
    {"start": 59.00, "end": 61.34, "text": "kdo zastaví válečnou noc?"},
    {"start": 61.34, "end": 64.22, "text": "Lék může zachránit lidský život,"},
    {"start": 64.22, "end": 66.16, "text": "ale mír musí chtít celý svět."},
    {"start": 66.16, "end": 68.04, "text": "Bílá nemoc, svědomí,"},
    {"start": 68.04, "end": 70.40, "text": "co člověk získá, když druhé porazí?"},
    {"start": 70.40, "end": 73.14, "text": "Čapek se ptá, kam vede nenávist,"},
    {"start": 73.14, "end": 78.48, "text": "když lidskost ustoupí touze po moci."},
    {"start": 78.48, "end": 80.34, "text": "Je to drama, protiválečný,"},
    {"start": 80.34, "end": 82.44, "text": "s prvky utopie a tragédie."},
    {"start": 82.44, "end": 84.46, "text": "Tři dějství, děj jde postupně,"},
    {"start": 84.46, "end": 87.02, "text": "na scéně sledujeme střetnutí idejí."},
    {"start": 87.02, "end": 88.14, "text": "Nemoc zasáhne svět,"},
    {"start": 88.14, "end": 89.60, "text": "čas není přesně určen."},
    {"start": 89.60, "end": 91.92, "text": "Nemocnice, domovy i mocenské sály,"},
    {"start": 91.92, "end": 96.44, "text": "ukazují společnost, kterou ovládá strach."},
    {"start": 96.44, "end": 98.44, "text": "Galén stojí za životem,"},
    {"start": 98.44, "end": 100.72, "text": "Maršál chce slávu a vítězství."},
    {"start": 100.72, "end": 103.36, "text": "Krüg představuje zbrojní průmysl,"},
    {"start": 103.36, "end": 105.60, "text": "jejich střet odhalí cenu války."},
    {"start": 105.60, "end": 108.04, "text": "Vypravěč tu žádný není,"},
    {"start": 108.04, "end": 110.18, "text": "postavy mluví přímo na scéně."},
    {"start": 110.18, "end": 112.00, "text": "Dialogy střídají monology,"},
    {"start": 112.00, "end": 114.34, "text": "každý hájí své postoje."},
    {"start": 114.34, "end": 116.58, "text": "Galén je skromný, pevný v přesvědčení,"},
    {"start": 116.58, "end": 118.80, "text": "Maršál je hrdý, věří ve svou moc."},
    {"start": 118.80, "end": 121.02, "text": "Když nemoc zasáhne i jeho,"},
    {"start": 121.02, "end": 123.60, "text": "začne pochybovat o válce a její ceně."},
    {"start": 123.60, "end": 125.88, "text": "Galén žádá mír, Maršál nakonec svolí,"},
    {"start": 125.88, "end": 128.16, "text": "jenže dav už žene válečná vášeň."},
    {"start": 128.16, "end": 130.18, "text": "Galén umírá, lék se ztrácí,"},
    {"start": 130.18, "end": 133.02, "text": "naději přehluší křik a nenávist."},
    {"start": 133.02, "end": 135.30, "text": "Čapek píše jasně, živě,"},
    {"start": 135.30, "end": 137.58, "text": "řeč postav zní přirozeně."},
    {"start": 137.58, "end": 139.88, "text": "Lékařské a politické výrazy"},
    {"start": 139.88, "end": 142.20, "text": "dávají příběhu věrohodnost."},
    {"start": 142.20, "end": 144.46, "text": "Ironie odhaluje mocných pýchu,"},
    {"start": 144.46, "end": 146.36, "text": "kontrast ukazuje cenu války."},
    {"start": 146.36, "end": 148.92, "text": "Běžné rozhovory vedle hrozby smrti"},
    {"start": 148.92, "end": 153.58, "text": "zdůrazní, jak snadno se ztrácí lidskost."},
    {"start": 153.58, "end": 157.32, "text": "Karel Čapek, novinář a spisovatel,"},
    {"start": 157.32, "end": 161.60, "text": "obhájce demokracie a člověka."},
    {"start": 161.60, "end": 165.84, "text": "Narodil se roku osmnáct set devadesát,"},
    {"start": 165.84, "end": 172.02, "text": "před válkou varoval ve svých hrách."},
    {"start": 172.02, "end": 174.16, "text": "R.U.R. a Válka s mloky,"},
    {"start": 174.16, "end": 176.14, "text": "Matka i Krakatit."},
    {"start": 176.14, "end": 178.72, "text": "Často řeší moc, odpovědnost,"},
    {"start": 178.72, "end": 181.02, "text": "techniku a nebezpečí fanatismu."},
    {"start": 181.02, "end": 183.02, "text": "Po Mnichovu, v roce třicet osm,"},
    {"start": 183.02, "end": 185.30, "text": "Čapek umírá ještě před okupací."},
    {"start": 185.30, "end": 187.60, "text": "Jeho varování však zůstává:"},
    {"start": 187.60, "end": 193.02, "text": "bez lidskosti mír neochráníme."},
    {"start": 193.02, "end": 195.14, "text": "Bílá nemoc, strach a moc,"},
    {"start": 195.14, "end": 197.30, "text": "kdo zastaví válečnou noc?"},
    {"start": 197.30, "end": 199.58, "text": "Drama, tři dějství, dialog,"},
    {"start": 199.58, "end": 202.22, "text": "střet svědomí a touhy po moci."},
    {"start": 202.22, "end": 204.42, "text": "Galén chce mír, Maršál chce slávu,"},
    {"start": 204.42, "end": 206.74, "text": "Čapek ukazuje cenu války."},
    {"start": 206.74, "end": 209.32, "text": "Nejde jen o nemoc těla,"},
    {"start": 209.32, "end": 212.00, "text": "ale o nemoc, která zasáhne lidskou morálku."}
  ]
}
